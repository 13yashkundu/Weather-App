<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_blue_purple_gradient"
    tools:context=".Home_page">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/main"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingTop="48dp"
            android:paddingEnd="20dp"
            android:paddingBottom="100dp">



        <TextView
            android:id="@+id/app_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawablePadding="8dp"
            android:fontFamily="@font/poppins"
            android:letterSpacing="0.08"
            android:text="WeatherZ"
            android:textColor="@color/primary_text"
            android:textSize="22sp"
            android:textStyle="bold"
            app:drawableStartCompat="@drawable/ic_logo_cloud"
            app:layout_constraintBottom_toBottomOf="@id/search_container"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/search_container" />

        <LinearLayout
            android:id="@+id/search_container"
            android:layout_width="190dp"
            android:layout_height="40dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_search_bar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="4dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <EditText
                android:id="@+id/search_bar"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:autofillHints="postalAddress"
                android:background="@null"
                android:fontFamily="@font/poppins"
                android:hint="Search city..."
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="@color/primary_text"
                android:textColorHint="@color/secondry_text"
                android:textSize="13sp" />

            <ImageView
                android:id="@+id/search_button"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_search_btn"
                android:contentDescription="Search button"
                android:padding="7dp"
                android:src="@drawable/ic_nav_search"
                app:tint="#FFFFFF" />

        </LinearLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/weather_card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_weather_card"
            android:padding="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/search_container">

            <TextView
                android:id="@+id/city_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins"
                android:textColor="#FFFFFF"
                android:textSize="21sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="📍New Delhi" />

            <TextView
                android:id="@+id/local_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/poppins"
                android:textColor="@color/secondry_text"
                android:textSize="12sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/city_name"
                tools:text="21:39 local time" />

            <TextView
                android:id="@+id/temprature_main"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/poppins"
                android:textColor="@color/temp_main"
                android:textSize="46sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/local_time"
                tools:text="22 °C" />

            <ImageView
                android:id="@+id/icon_day"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:contentDescription="Weather condition icon"
                app:tint="#FFFFFF"
                app:layout_constraintBottom_toBottomOf="@id/temprature_main"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/temprature_main"
                tools:src="@drawable/night_icon" />

            <TextView
                android:id="@+id/weather_condition"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins"
                android:textColor="@color/primary_text"
                android:textSize="15sp"
                app:layout_constraintStart_toStartOf="@id/temprature_main"
                app:layout_constraintTop_toBottomOf="@id/temprature_main"
                tools:text="Sunny" />

            <TextView
                android:id="@+id/feels_like_temp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/poppins"
                android:textColor="@color/secondry_text"
                android:textSize="13sp"
                app:layout_constraintBottom_toBottomOf="@id/weather_condition"
                app:layout_constraintStart_toEndOf="@id/weather_condition"
                app:layout_constraintTop_toTopOf="@id/weather_condition"
                tools:text="• Feels like 24 °C" />

            <TextView
                android:id="@+id/min_temp_t"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/poppins"
                android:text="Min: "
                android:textColor="@color/temp_min"
                android:textSize="14sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/weather_condition" />

            <TextView
                android:id="@+id/min_temp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins"
                android:textColor="@color/temp_min"
                android:textSize="14sp"
                app:layout_constraintStart_toEndOf="@id/min_temp_t"
                app:layout_constraintTop_toTopOf="@id/min_temp_t"
                tools:text="20 °C" />

            <TextView
                android:id="@+id/max_temp_t"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:fontFamily="@font/poppins"
                android:text="Max: "
                android:textColor="@color/temp_max"
                android:textSize="14sp"
                app:layout_constraintStart_toEndOf="@id/min_temp"
                app:layout_constraintTop_toTopOf="@id/min_temp" />

            <TextView
                android:id="@+id/max_temp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins"
                android:textColor="@color/temp_max"
                android:textSize="14sp"
                app:layout_constraintStart_toEndOf="@id/max_temp_t"
                app:layout_constraintTop_toTopOf="@id/max_temp_t"
                tools:text="10 °C" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Today's Highlights Heading -->
        <TextView
            android:id="@+id/highlight_heading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/poppins"
            android:text="Today's Highlights"
            android:textColor="@color/primary_text"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/weather_card" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/card_uv_index"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_weather_card"
            android:padding="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/highlight_heading">

            <TextView
                android:id="@+id/label_uv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins"
                android:letterSpacing="0.06"
                android:text="☀️ UV INDEX"
                android:textColor="@color/secondry_text"
                android:textSize="11sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/text_uv_val"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/poppins"
                android:textColor="@color/primary_text"
                android:textSize="22sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/label_uv"
                tools:text="9" />

            <TextView
                android:id="@+id/text_uv_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/poppins"
                android:textColor="@color/secondry_text"
                android:textSize="12sp"
                app:layout_constraintBottom_toBottomOf="@id/text_uv_val"
                app:layout_constraintStart_toEndOf="@id/text_uv_val"
                app:layout_constraintTop_toTopOf="@id/text_uv_val"
                tools:text="Very High" />

            <SeekBar
                android:id="@+id/uv_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="12dp"
                android:layout_marginTop="8dp"
                android:clickable="false"
                android:focusable="false"
                android:indeterminate="false"
                android:max="11"
                android:maxHeight="4dp"
                android:minHeight="4dp"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:progressDrawable="@drawable/custom_uv_full_spectrum_track"
                android:splitTrack="false"
                android:thumb="@drawable/ic_progress_dot"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/text_uv_val"
                tools:progress="5" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- 2x2 Highlights Grid -->
        <GridLayout
            android:id="@+id/today_highlight_grid"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:columnCount="2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/card_uv_index">

            <!-- Card 1: Sunrise & Sunset -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/card_sunrise"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:background="@drawable/bg_weather_card"
                android:padding="14dp">

                <TextView
                    android:id="@+id/label_sunrise"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins"
                    android:letterSpacing="0.06"
                    android:text="🌅 SUNRISE"
                    android:textColor="@color/secondry_text"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/text_sunrise"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/poppins"
                    android:textColor="@color/primary_text"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/label_sunrise"
                    tools:text="06:12 AM" />

                <TextView
                    android:id="@+id/text_sunset"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/poppins"
                    android:textColor="@color/secondry_text"
                    android:textSize="11sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/text_sunrise"
                    tools:text="Sunset: 06:45 PM" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Card 2: Wind Speed & Direction -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/card_wind"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:background="@drawable/bg_weather_card"
                android:padding="14dp">

                <TextView
                    android:id="@+id/label_wind"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins"
                    android:letterSpacing="0.06"
                    android:text="💨 WIND"
                    android:textColor="@color/secondry_text"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/text_wind_val"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/poppins"
                    android:textColor="@color/primary_text"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/label_wind"
                    tools:text="14 km/h" />

                <TextView
                    android:id="@+id/text_wind_dir"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/poppins"
                    android:textColor="@color/secondry_text"
                    android:textSize="11sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/text_wind_val"
                    tools:text="NW Direction" />

            </androidx.constraintlayout.widget.ConstraintLayout>


            <!-- Card 3: Visibility -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/card_visibility"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:background="@drawable/bg_weather_card"
                android:padding="14dp">

                <TextView
                    android:id="@+id/label_visibility"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins"
                    android:letterSpacing="0.06"
                    android:text="👁️ VISIBILITY"
                    android:textColor="@color/secondry_text"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/text_vis_val"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/poppins"
                    android:textColor="@color/primary_text"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/label_visibility"
                    tools:text="10 km" />

                <TextView
                    android:id="@+id/text_vis_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/poppins"
                    android:textColor="@color/secondry_text"
                    android:textSize="11sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/text_vis_val"
                    tools:text="Clear view" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Card 4: Humidity -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/card_humidity"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:background="@drawable/bg_weather_card"
                android:padding="14dp">

                <TextView
                    android:id="@+id/label_humidity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins"
                    android:letterSpacing="0.06"
                    android:text="💧 HUMIDITY"
                    android:textColor="@color/secondry_text"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/text_humidity_val"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/poppins"
                    android:textColor="@color/primary_text"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/label_humidity"
                    tools:text="64%" />

                <TextView
                    android:id="@+id/text_humidity_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/poppins"
                    android:textColor="@color/secondry_text"
                    android:textSize="11sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/text_humidity_val"
                    tools:text="Comfortable" />

                <SeekBar
                    android:id="@+id/humidity_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="12dp"
                    android:layout_marginTop="8dp"
                    android:clickable="false"
                    android:focusable="false"
                    android:indeterminate="false"
                    android:max="100"
                    android:maxHeight="4dp"
                    android:minHeight="4dp"
                    android:paddingStart="5dp"
                    android:paddingEnd="5dp"
                    android:progressDrawable="@drawable/custom_humidity_full_spectrum_track"
                    android:splitTrack="false"
                    android:thumb="@drawable/ic_progress_dot"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/text_humidity_desc"
                    tools:progress="64" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </GridLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/hourly_graph_card"
            android:layout_width="0dp"
            android:layout_height="260dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_weather_card"
            android:padding="12dp"
            app:layout_constraintTop_toBottomOf="@id/today_highlight_grid"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/hourly_graph_heading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hourly Temperature"
                android:textColor="@color/primary_text"
                android:textSize="18sp"
                android:textStyle="bold"
                android:fontFamily="@font/poppins"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <com.github.mikephil.charting.charts.LineChart
                android:id="@+id/temperature_chart"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@id/hourly_graph_heading"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/forecast_card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/hourly_graph_card">

            <TextView
                android:id="@+id/forecast_heading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins"
                android:text="3 Days Forecast"
                android:textColor="@color/primary_text"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/fragment_recycler"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:nestedScrollingEnabled="false"
                android:orientation="horizontal"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/forecast_heading"
                tools:itemCount="7"
                tools:listitem="@layout/fragment_forecast_card" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/loading_blur"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#800B0B0D"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/weatherLoading"
            style="?android:attr/progressBarStyle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:indeterminate="true"
            android:indeterminateTint="#A9C7FF"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>
