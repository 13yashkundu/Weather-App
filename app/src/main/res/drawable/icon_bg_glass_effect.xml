<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Glassmorphism gradient (gloss top light reflection to subtle translucent body) -->
    <solid android:color="#5F1D1A1A" />

    <!-- Glass edge stroke -->
    <stroke
        android:width="1dp"
        android:color="#40FFFFFF" />

    <!-- Rounded corners -->
    <corners android:radius="30dp" />
</shape>
